DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=rfb
IMPORT_DB_NAME=rfb_import
OPERATIONAL_DB_NAME=rfb_ops
DB_LOCAL_INFILE=True

INPUT_DIR=data/input
EXTRACT_DIR=data/extracted
LOG_DIR=logs
BATCH_SIZE=10000
MAX_WORKERS=4
LOAD_STRATEGY=load_data
MERGE_STRATEGY=full_refresh

LOAD_TARGET=final
SYNC_STRATEGY=raw_import
ENABLE_ADAPTIVE_WORKERS=True
MIN_WORKERS=1
ADAPTIVE_CPU_HIGH=85
ADAPTIVE_RAM_HIGH=85
ADAPTIVE_CPU_LOW=45
ADAPTIVE_RAM_LOW=65
AUTO_KILL_BLOCKING_SESSIONS=False
AUTO_KILL_MIN_SECONDS=300
AUTO_KILL_WAIT_SECONDS=10
ENABLE_PARALLELISM=True

DB_CONNECT_TIMEOUT=30
DB_READ_TIMEOUT=600
DB_WRITE_TIMEOUT=600
DB_CREATE_RETRIES=5
DB_CREATE_RETRY_DELAY=10

IMPORT_DB_PER_RUN=False
RAW_IMPORT_RESET_SCHEMA=True
RAW_IMPORT_RESET_TABLES=True
RAW_IMPORT_FAST_SCHEMA=True
PROMOTE_RAW_IMPORT_AFTER_LOAD=True
DB_PROMOTION_STRATEGY=rename_swap
DB_PROMOTION_BATCH_SIZE=50000
MONITORED_FIELDS_BOOTSTRAP_DEFAULTS=True
CONTROL_DIFF_MAX_ROWS=1000
CONTROL_DIFF_DETAIL_TABLES=cnae,moti,munic,natju,pais,quals
