classDiagram
    class Settings {
        DB_NAME
        IMPORT_DB_NAME
        OPERATIONAL_DB_NAME
        SYNC_STRATEGY
        LOAD_TARGET
        LOAD_STRATEGY
        RAW_IMPORT_FAST_SCHEMA
        PROMOTE_RAW_IMPORT_AFTER_LOAD
        CONTROL_DIFF_MAX_ROWS
        CONTROL_DIFF_DETAIL_TABLES
        create_dirs()
    }

    class ETLOrchestrator {
        run()
        _run_raw_import_pipeline()
        _process_rfb_table(table)
        _discover_table_files(table)
        _execute_pipeline(file_path, staging_model, columns, key, table_name)
    }

    class RFBTableDefinition {
        table_name
        patterns
        columns
        key_columns
    }

    class BulkRepository {
        load_file_to_staging(table_name, file_path)
        load_generic_rfb_file_to_staging(table_name, file_path)
        _load_data_local_infile(table_name, file_path, columns, set_clause)
        bulk_insert(model, data)
    }

    class RawImportPromotionRepository {
        promote()
        _copy_all_tables_to_final()
        _compare_or_copy_table(table_name, columns, key_columns)
        _replace_final_table(conn, table_name)
        _insert_control(conn, table_name, status, alteration)
    }

    class ObservabilityRepository {
        start_run()
        heartbeat_run()
        start_phase()
        finish_phase()
        start_file_progress()
        finish_file_progress()
        checkpoint()
        metric()
    }

    class ETLExecutionRepository {
        start()
        success()
        failed()
        retry()
    }

    class DatabaseSessions {
        SessionLocal
        OperationalSessionLocal
        engine
        operational_engine
    }

